# ---- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct (unpooled) connection used by Prisma migrations. On Neon/Supabase this
# is the non-pooler host; elsewhere it can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- NextAuth --------------------------------------------------------------
# Canonical URL of the deployment, e.g. https://youtube-learn.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---- Google OAuth ----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- YouTube Data API v3 ---------------------------------------------------
# Server-side API key. Never prefix this with NEXT_PUBLIC_.
YOUTUBE_API_KEY=""

# ---- Optional --------------------------------------------------------------
# Overrides the Buy Me a Coffee handle behind the sidebar support button.
# Leave blank to use the project default (aditya.galaxy).
#
# NOTE: the quotes below are .env syntax and are stripped when the file is read.
# A hosting dashboard (Vercel, Netlify) stores the value exactly as typed, so
# paste only the handle there — `aditya.galaxy`, not `"aditya.galaxy"`.
NEXT_PUBLIC_BUYMEACOFFEE_USERNAME=""
