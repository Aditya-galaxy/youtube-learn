# ---- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct (unpooled) connection used by Prisma migrations. On Neon/Supabase this
# is the non-pooler host; elsewhere it can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- NextAuth --------------------------------------------------------------
# Canonical URL of the deployment, e.g. https://youtube-learn.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---- Google OAuth ----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- YouTube Data API v3 ---------------------------------------------------
# Server-side API key. Never prefix this with NEXT_PUBLIC_.
YOUTUBE_API_KEY=""

# ---- Gemini (course generation) --------------------------------------------
# Two backends. Vertex AI bills to your GCP project and uses Application Default
# Credentials (`gcloud auth application-default login`) — no key needed:
GOOGLE_GENAI_USE_VERTEXAI=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
# ...or the Gemini Developer API with an AI Studio key (billed by AI Studio
# prepayment; returns 402 once credits run out):
# Used to design curricula and write lesson notes. Server-side only — never
# prefix this with NEXT_PUBLIC_. https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional. Gemini ships new model ids often; override the default here.
# List what a key can reach: GET https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=""
