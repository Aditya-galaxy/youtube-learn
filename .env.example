# ---- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Direct (unpooled) connection used by Prisma migrations. On Neon/Supabase this
# is the non-pooler host; elsewhere it can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- NextAuth --------------------------------------------------------------
# Canonical URL of the deployment, e.g. https://youtube-learn.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---- Google OAuth ----------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- YouTube Data API v3 ---------------------------------------------------
# Server-side API key. Never prefix this with NEXT_PUBLIC_.
YOUTUBE_API_KEY=""

# ---- Optional --------------------------------------------------------------
# Username for the sidebar "Buy me a Coffee" button. The button is hidden when
# this is unset.
NEXT_PUBLIC_BUYMEACOFFEE_USERNAME=""
