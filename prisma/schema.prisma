generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String                @id @default(cuid())
  name           String?
  email          String?               @unique
  emailVerified  DateTime?
  image          String?
  lastSignIn     DateTime?
  lastSignOut    DateTime?
  loginCount     Int                   @default(0)
  bio            String?
  learningGoal   String?
  skillLevel     SkillLevel            @default(BEGINNER)
  weeklyHours    Int                   @default(3)
  accounts       Account[]
  sessions       Session[]
  userTokens     UserTokens?
  viewedVideos   ViewedVideos[]
  enrollments    CourseEnrollment[]
  lessonProgress UserLessonProgress[]
  notes          LessonNote[]
  createdCourses Course[]              @relation("CreatedCourses")
  generationJobs CourseGenerationJob[]

  @@map("users")
}

model UserTokens {
  id            String @id @default(cuid())
  userId        String @unique
  tokensUsed    Int    @default(0)
  lastResetHour Int    @default(0)
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_tokens")
}

model ViewedVideos {
  id       String   @id @default(cuid())
  userId   String
  videoId  String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@map("viewed_videos")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

enum SkillLevel {
  BASIC
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CourseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Course {
  id              String             @id @default(cuid())
  slug            String             @unique
  title           String
  description     String
  thumbnail       String
  category        String
  difficulty      SkillLevel         @default(BEGINNER)
  estimatedHours  Float              @default(1.0)
  instructor      String?
  institution     String?
  sourceUrl       String?
  tier            String?
  isPublic        Boolean            @default(true)
  isAiGenerated   Boolean            @default(false)
  /// The topic a generated course was built from, as the user typed it.
  topic           String?
  /// Lowercased, whitespace-collapsed topic — the key for "does a path for
  /// this already exist?", which saves a whole generation's cost and quota.
  topicNormalized String?
  creatorId       String?
  creator         User?              @relation("CreatedCourses", fields: [creatorId], references: [id], onDelete: SetNull)
  modules         Module[]
  enrollments     CourseEnrollment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([category])
  @@index([topicNormalized, difficulty])
  @@map("courses")
}

model Module {
  id               String   @id @default(cuid())
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  orderIndex       Int
  description      String?
  /// Stable syllabus key, e.g. "matrices-and-operations".
  key              String?
  objectives       String[] @default([])
  /// Keys of modules that must come first — the dependency graph behind the
  /// ordering, kept so the roadmap view can draw it later.
  prerequisiteKeys String[] @default([])
  /// Lessons the syllabus planned but no good video was found for. Shown to
  /// the learner rather than silently dropped.
  unfilledLessons  String[] @default([])
  lessons          Lesson[]

  @@unique([courseId, orderIndex])
  @@map("modules")
}

model Lesson {
  id           String               @id @default(cuid())
  moduleId     String
  module       Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  orderIndex   Int
  videoId      String
  channelName  String?
  durationSec  Int                  @default(0)
  startSeconds Int                  @default(0)
  endSeconds   Int?
  summary      String?
  progress     UserLessonProgress[]
  notes        LessonNote[]
  grounding    LessonGrounding?

  @@unique([moduleId, orderIndex])
  @@index([videoId])
  @@map("lessons")
}

/// What the model found when it actually watched this lesson's video.
///
/// Built once per lesson and shared by every learner, so the tutor can teach
/// from the lecture's own structure instead of guessing at it. Timestamps are
/// the model's reading of the video and are treated as approximate: the tutor
/// may offer to jump to a section start, never to a precise claim like "at
/// 4:10 he says X".
model LessonGrounding {
  lessonId     String   @id
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  videoId      String
  model        String
  /// [{ startSeconds, title, summary }], ordered, within the video's length.
  sections     Json
  /// [{ term, definition }] taught in this lecture.
  keyConcepts  Json
  promptTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("lesson_grounding")
}

model CourseEnrollment {
  id             String       @id @default(cuid())
  userId         String
  courseId       String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status         CourseStatus @default(IN_PROGRESS)
  progressPct    Int          @default(0)
  lastAccessedAt DateTime     @default(now())
  enrolledAt     DateTime     @default(now())
  /// Where "Resume" should land. Not a foreign key on purpose: a lesson being
  /// regenerated must not cascade-delete someone's enrollment.
  lastLessonId   String?

  @@unique([userId, courseId])
  @@index([userId])
  @@map("course_enrollments")
}

model UserLessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted     Boolean   @default(false)
  lastPositionSec Int       @default(0)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("user_lesson_progress")
}

model LessonNote {
  id                String   @id @default(cuid())
  userId            String
  lessonId          String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content           String
  videoTimestampSec Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// One note per user per lesson — the classroom has a single notes pad, and
  /// a unique key lets saves be an upsert instead of find-then-write.
  @@unique([userId, lessonId])
  @@map("lesson_notes")
}

enum GenerationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// One course build. Generation takes minutes — longer than a request should
/// live — so it runs as a job that advances one step per invocation and is
/// polled by the progress page. Step 0 designs the syllabus; step k builds
/// module k; the last step persists the course.
model CourseGenerationJob {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic           String
  topicNormalized String
  difficulty      SkillLevel       @default(BEGINNER)
  weeklyHours     Int?
  status          GenerationStatus @default(QUEUED)
  step            Int              @default(0)
  totalSteps      Int              @default(0)
  progressPct     Int              @default(0)
  /// Human-readable description of the step in flight, for the progress page.
  stageLabel      String?
  /// Syllabus and per-module results, accumulated step by step.
  payload         Json?
  warnings        String[]         @default([])
  /// Token and YouTube-unit spend, so cost per course is measured, not guessed.
  usage           Json?
  courseId        String?
  error           String?
  attempts        Int              @default(0)
  /// Set while a worker holds the job; a stale lock is reclaimable.
  lockedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, status])
  @@index([status, updatedAt])
  @@map("course_generation_jobs")
}

/// YouTube Data API units spent per quota day. The key is the date in Pacific
/// time, because that is when YouTube resets the project's daily quota. One
/// shared counter matters because every user draws on the same key: without
/// it, a few course builds can exhaust the day and take the video feed down for
/// everyone.
model YoutubeQuotaUsage {
  day       String   @id
  unitsUsed Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("youtube_quota_usage")
}
